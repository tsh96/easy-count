# Docker Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database URL (Neon PostgreSQL)
DATABASE_URL=******host/database?sslmode=require

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here-change-this-in-production

# Environment (production or development)
ENVIRONMENT=production

# Server Port (8080 is standard for Docker)
PORT=8080

# CORS Allowed Origins (comma-separated)
# For production, set this to your actual domain
ALLOW_ORIGINS=http://localhost:8080

# Optional: If using local PostgreSQL instead of Neon
# DATABASE_URL=postgres://easycount:easycount@postgres:5432/easycount?sslmode=disable
